        <mxCell id='sm-e-lock-intent' value='acquires receipt-registry lease' style='edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1a73e8;labelBackgroundColor=#ffffff;fontSize=9;exitX=1;exitY=0.500;entryX=0;entryY=0.500;jumpStyle=arc;jumpSize=8;exitDx=0;exitDy=0;entryDx=0;entryDy=0;labelBorderColor=#dfe1e5;spacing=2;' edge='1' parent='1' source='sm-lock' target='sm-intent' customRouteVersion='2.2' customLabelLayoutVersion='2.3'>
