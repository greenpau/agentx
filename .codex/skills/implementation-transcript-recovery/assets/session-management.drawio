<mxfile host='app.diagrams.net' modified='2026-07-27T00:00:00.000Z' agent='Codex' version='24.7.17' type='device'>
  <diagram id='native-session-management' name='Native session management'>
    <mxGraphModel dx='3260' dy='1280' grid='1' gridSize='10' guides='1' tooltips='1' connect='1' arrows='1' fold='1' page='1' pageScale='1' pageWidth='3260' pageHeight='1697' math='0' shadow='0' customDiagramContextVersion='2.1' customContextEndsWith='bounded list page or closed single-delete outcome · VS Code metadata unchanged' customContextDefersTo='implementation-headless-sdk · CLI/output · implementation-startup-settings · bootstrap · implementation-platform-lifecycle · locks/detach/sync/cleanup'>
      <root>
        <mxCell id='0'/>
        <mxCell id='1' parent='0'/>
        <mxCell id='sm-title' value='Authoritative native session inventory and deletion' style='text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#202124;' vertex='1' parent='1'>
          <mxGeometry x='50' y='390' width='1850' height='42' as='geometry'/>
        </mxCell>
        <mxCell id='sm-subtitle' value='One runtime-owned SessionManager scopes every decision to the frozen application home and normalized selected workspace. Provider-free CLI management and semantic-runtime selectors share the same store truth. &lt;b&gt;Contracts: TX-068 · TX-069.&lt;/b&gt;' style='text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontSize=12;fontColor=#5f6368;' vertex='1' parent='1'>
          <mxGeometry x='50' y='432' width='2570' height='45' as='geometry'/>
        </mxCell>
        <mxCell id='sm-entry-label' value='ENTRY + FROZEN IDENTITY' style='text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#1a73e8;' vertex='1' parent='1'>
          <mxGeometry x='50' y='490' width='590' height='24' as='geometry'/>
        </mxCell>
        <mxCell id='sm-cli' value='&lt;b&gt;ENTRY · provider-free CLI&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;--list-sessions&lt;/font&gt; or &lt;font face=&quot;monospace&quot;&gt;--delete-session ID&lt;/font&gt;&lt;br&gt;explicit &lt;font face=&quot;monospace&quot;&gt;--cwd&lt;/font&gt; · text or one versioned JSON object&lt;br&gt;management modes reject prompts and conversation options' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#80868b;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;' vertex='1' parent='1'>
          <mxGeometry x='50' y='572' width='275' height='135' as='geometry'/>
        </mxCell>
        <mxCell id='sm-bootstrap' value='&lt;b&gt;BOUNDARY · frozen bootstrap&lt;/b&gt;&lt;br&gt;preserve application-home + auth-presence bootstrap&lt;br&gt;normalize the absolute selected workspace&lt;br&gt;caller supplies no home, hash, session path, or transcript path' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#80868b;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;' vertex='1' parent='1'>
          <mxGeometry x='375' y='572' width='285' height='135' as='geometry'/>
        </mxCell>
        <mxCell id='sm-manager' value='&lt;b&gt;OWNER · SessionManager&lt;/b&gt;&lt;br&gt;derives workspace partition internally&lt;br&gt;opens existing state read-only for inventory&lt;br&gt;validates native IDs, entries, stages, receipts, revisions, and identity&lt;br&gt;owns List · Delete · State · Latest' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#1a73e8;strokeColor=#174ea6;strokeWidth=3;fontColor=#ffffff;fontSize=13;align=left;verticalAlign=middle;spacingLeft=11;' vertex='1' parent='1'>
          <mxGeometry x='720' y='562' width='320' height='175' as='geometry'/>
        </mxCell>
        <mxCell id='sm-list' value='&lt;b&gt;FAN-OUT · bounded complete inventory&lt;/b&gt;&lt;br&gt;scan only the selected workspace partition&lt;br&gt;missing partition → empty without creation&lt;br&gt;validate bounded direct entries + reserved stages + receipt registry&lt;br&gt;exclude incomplete forks, live intents, pending receipts, and detached stages&lt;br&gt;unsafe safe-looking identity → whole-scan &lt;font face=&quot;monospace&quot;&gt;store_unsafe&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;' vertex='1' parent='1'>
          <mxGeometry x='1100' y='522' width='345' height='165' as='geometry'/>
        </mxCell>
        <mxCell id='sm-page' value='&lt;b&gt;OUTCOME · stable page&lt;/b&gt;&lt;br&gt;transcript mtime descending, then session ID ascending&lt;br&gt;bounded page; generation-bound opaque continuation token&lt;br&gt;minimal fields: ID · updated_at · opaque revision&lt;br&gt;closed statuses: &lt;font face=&quot;monospace&quot;&gt;ok | stale | store_unsafe&lt;/font&gt;&lt;br&gt;never silently truncates' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;strokeWidth=2;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;' vertex='1' parent='1'>
          <mxGeometry x='1510' y='522' width='340' height='165' as='geometry'/>
        </mxCell>
        <mxCell id='sm-selectors' value='&lt;b&gt;FAN-OUT · authoritative selection guard&lt;/b&gt;&lt;br&gt;resume · continue-latest · fork source · explicit creation&lt;br&gt;all query the same SessionManager state&lt;br&gt;no duplicate workspace scan or latest-session policy' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;' vertex='1' parent='1'>
          <mxGeometry x='1100' y='737' width='345' height='135' as='geometry'/>
        </mxCell>
        <mxCell id='sm-selection-outcome' value='&lt;b&gt;OUTCOME · selectable or reserved&lt;/b&gt;&lt;br&gt;only a complete validated native candidate is resumable&lt;br&gt;incomplete fork, live intent, pending receipt, or detached stage stays hidden and reserves the original ID&lt;br&gt;a completed receipt does not reserve a genuinely new generation' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;strokeWidth=2;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;' vertex='1' parent='1'>
          <mxGeometry x='1510' y='727' width='340' height='155' as='geometry'/>
        </mxCell>
        <mxCell id='sm-vscode-scope' value='&lt;b&gt;OUT OF SCOPE · VS Code&lt;/b&gt;&lt;br&gt;no AgentX VS Code extension mutation&lt;br&gt;no presentation-cache or topic-metadata deletion&lt;br&gt;the extension retains its own local metadata' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#d93025;strokeWidth=2;dashed=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;' vertex='1' parent='1'>
          <mxGeometry x='1940' y='522' width='390' height='135' as='geometry'/>
        </mxCell>
        <mxCell id='sm-provider-free' value='&lt;b&gt;PROVIDER-FREE STOP LINE&lt;/b&gt;&lt;br&gt;list/delete create no semantic session, query engine, transcript, workspace partition, project memory, model/provider connection, extension registry, MCP connection, or structured duplex control handler' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#5f6368;strokeWidth=2;dashed=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;' vertex='1' parent='1'>
          <mxGeometry x='2390' y='522' width='545' height='135' as='geometry'/>
        </mxCell>
        <mxCell id='sm-delete-label' value='DELETE COMMIT PATH · EXACTLY ONE SESSION · LOCK HELD UNTIL LIVE NAME IS UNREACHABLE' style='text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#1a73e8;' vertex='1' parent='1'>
          <mxGeometry x='720' y='900' width='1680' height='24' as='geometry'/>
        </mxCell>
        <mxCell id='sm-lock' value='&lt;b&gt;DECISION · acquire target lock&lt;/b&gt;&lt;br&gt;open the existing native lock&lt;br&gt;nonblocking acquisition&lt;br&gt;capture and verify parent, target, and lock identity&lt;br&gt;never terminates an active owner' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;align=left;verticalAlign=middle;spacingLeft=9;' vertex='1' parent='1'>
          <mxGeometry x='720' y='1007' width='230' height='160' as='geometry'/>
        </mxCell>
        <mxCell id='sm-intent' value='&lt;b&gt;DECISION · lock bounded receipt registry&lt;/b&gt;&lt;br&gt;registry lease serializes headroom, publication, detach, and completion&lt;br&gt;validate ≤512 entries; pending never evicted&lt;br&gt;retain 256 complete; retire older complete receipts through validated &lt;font face=&quot;monospace&quot;&gt;g1_&lt;/font&gt; GC staging' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=8;align=left;verticalAlign=middle;spacingLeft=9;' vertex='1' parent='1'>
          <mxGeometry x='990' y='1007' width='230' height='160' as='geometry'/>
        </mxCell>
        <mxCell id='sm-receipt-registry' value='&lt;b&gt;STORE · live intent → pending receipt&lt;/b&gt;&lt;br&gt;while target + registry leases remain held:&lt;br&gt;1 · persist/sync no-replace intent under the live target&lt;br&gt;2 · publish canonical immutable receipt no-replace&lt;br&gt;receipt binds workspace, directory, transcript, and lock identities; the stage is still absent' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;fontSize=9;align=left;verticalAlign=middle;spacingLeft=9;' vertex='1' parent='1'>
          <mxGeometry x='1260' y='997' width='300' height='180' as='geometry'/>
        </mxCell>
        <mxCell id='sm-revalidate' value='&lt;b&gt;DECISION · immediate revalidation&lt;/b&gt;&lt;br&gt;ID + workspace membership&lt;br&gt;revision + parent + target&lt;br&gt;transcript + target-lock identities&lt;br&gt;live intent + exact pending receipt' style='rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=9;align=center;verticalAlign=middle;' vertex='1' parent='1'>
          <mxGeometry x='1600' y='997' width='250' height='180' as='geometry'/>
        </mxCell>
        <mxCell id='sm-detach' value='&lt;b&gt;COMMIT · atomic detach + sync&lt;/b&gt;&lt;br&gt;identity-verified same-parent no-replace rename&lt;br&gt;reserved validated invalid-ID stage&lt;br&gt;pending receipt + both leases remain held&lt;br&gt;sync partition after namespace mutation' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=10;align=left;verticalAlign=middle;spacingLeft=9;' vertex='1' parent='1'>
          <mxGeometry x='1890' y='1007' width='250' height='160' as='geometry'/>
        </mxCell>
        <mxCell id='sm-release' value='&lt;b&gt;STATE · release target lock; retain registry lease&lt;/b&gt;&lt;br&gt;release the target/staged session lock only after the live valid-ID name is unreachable&lt;br&gt;ordinary selection cannot reach it&lt;br&gt;carry the registry lease through cleanup and completion' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;align=left;verticalAlign=middle;spacingLeft=9;' vertex='1' parent='1'>
          <mxGeometry x='2180' y='1007' width='250' height='160' as='geometry'/>
        </mxCell>
        <mxCell id='sm-cleanup' value='&lt;b&gt;PROCESS · descriptor-rooted cleanup&lt;/b&gt;&lt;br&gt;registry lease remains held across cleanup&lt;br&gt;remove only the validated detached OwnedDirectory through rooted safety primitives&lt;br&gt;never recursively remove the live directory&lt;br&gt;cleanup remains bounded and retryable' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;align=left;verticalAlign=middle;spacingLeft=9;' vertex='1' parent='1'>
          <mxGeometry x='2470' y='1007' width='250' height='160' as='geometry'/>
        </mxCell>
        <mxCell id='sm-deleted' value='&lt;b&gt;STORE + OUTCOME · complete receipt → deleted&lt;/b&gt;&lt;br&gt;retain the live-path registry lease, or acquire it after the staged-session lock on retry&lt;br&gt;sync partition; prove stage + bound directory absent with a fresh bounded scan&lt;br&gt;persist and verify completion, then release registry&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;deleted&lt;/font&gt; means local native-store absence—not secure erasure' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#34a853;strokeColor=#137333;strokeWidth=3;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=middle;spacingLeft=9;' vertex='1' parent='1'>
          <mxGeometry x='2760' y='997' width='450' height='180' as='geometry'/>
        </mxCell>
        <mxCell id='sm-not-found' value='&lt;b&gt;OUTCOME · not_found&lt;/b&gt;&lt;br&gt;no matching live candidate or validated retry stage' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#80868b;strokeWidth=2;fontSize=11;' vertex='1' parent='1'>
          <mxGeometry x='720' y='1252' width='250' height='85' as='geometry'/>
        </mxCell>
        <mxCell id='sm-session-locked' value='&lt;b&gt;OUTCOME · session_locked&lt;/b&gt;&lt;br&gt;another process owns a required healthy lock; no mutation' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;' vertex='1' parent='1'>
          <mxGeometry x='990' y='1252' width='260' height='85' as='geometry'/>
        </mxCell>
        <mxCell id='sm-stale' value='&lt;b&gt;OUTCOME · stale&lt;/b&gt;&lt;br&gt;revision/generation changed, or an old receipt/token names a newer live or staged generation; replacement stays untouched' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=10;' vertex='1' parent='1'>
          <mxGeometry x='1450' y='1252' width='300' height='95' as='geometry'/>
        </mxCell>
        <mxCell id='sm-store-unsafe' value='&lt;b&gt;OUTCOME · store_unsafe&lt;/b&gt;&lt;br&gt;unsafe, linked, replaced, malformed, or contradictory identity fails closed' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#d93025;strokeWidth=2;fontSize=11;' vertex='1' parent='1'>
          <mxGeometry x='1835' y='1252' width='300' height='85' as='geometry'/>
        </mxCell>
        <mxCell id='sm-incomplete' value='&lt;b&gt;RECOVERY STATE · delete_incomplete / cleanup_pending&lt;/b&gt;&lt;br&gt;Any retained live intent, pending receipt, detached stage, owned content, unsynced absence, or unverified completion marker is hidden-but-retained data—not deletion. Retry with the original session ID + opaque revision resumes receipt publication, detach, cleanup, sync, or completion; a different generation cannot inherit this evidence.' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#d93025;strokeWidth=3;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;' vertex='1' parent='1'>
          <mxGeometry x='1310' y='1447' width='1605' height='105' as='geometry'/>
        </mxCell>
        <mxCell id='sm-e-entry-bootstrap' value='freezes app + workspace identity' style='edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1a73e8;labelBackgroundColor=#ffffff;fontSize=9;exitX=1;exitY=0.500;entryX=0;entryY=0.667;jumpStyle=arc;jumpSize=8;exitDx=0;exitDy=0;entryDx=0;entryDy=0;labelBorderColor=#dfe1e5;spacing=2;' edge='1' parent='1' source='sm-cli' target='sm-bootstrap' customRouteVersion='2.2' customFullSemanticLabel='freezes app + workspace identity' customLabelLayoutVersion='2.3'>
