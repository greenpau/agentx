          <mxGeometry x='330' y='750' width='255' height='80' as='geometry'/>
        </mxCell>
        <mxCell id='sandboxallow' value='&lt;b&gt;ALLOW with sandbox reason&lt;/b&gt;&lt;br&gt;executor must still prove selected sandbox&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;BASH-AUTH-090,095&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;' vertex='1' parent='1'>
