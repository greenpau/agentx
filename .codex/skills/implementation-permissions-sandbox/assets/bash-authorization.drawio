        <mxCell id='sandboxgate' value='Sandbox auto-allow eligible and selected?' style='rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;' vertex='1' parent='1'>
          <mxGeometry x='50' y='735' width='230' height='110' as='geometry'/>
