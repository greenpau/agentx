          <mxGeometry x='50' y='900' width='280' height='85' as='geometry'/>
        </mxCell>
        <mxCell id='operators' value='&lt;b&gt;Operator recursion&lt;/b&gt;&lt;br&gt;authorize each pipeline/list side; then recheck original safety, redirects, paths&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;BASH-AUTH-060..061&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;' vertex='1' parent='1'>
          <mxGeometry x='380' y='900' width='290' height='85' as='geometry'/>
        </mxCell>
        <mxCell id='split' value='&lt;b&gt;Split + bounded state checks&lt;/b&gt;&lt;br&gt;remove exact cwd no-op; max 50 legacy spans; multiple cd; cd + git&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;BASH-AUTH-062..065&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;' vertex='1' parent='1'>
          <mxGeometry x='720' y='900' width='300' height='85' as='geometry'/>
        </mxCell>
        <mxCell id='segment' value='&lt;b&gt;For every executable span&lt;/b&gt;&lt;br&gt;exact/prefix deny + ask first&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;BASH-AUTH-050 step 9&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;' vertex='1' parent='1'>
          <mxGeometry x='50' y='1050' width='240' height='75' as='geometry'/>
        </mxCell>
        <mxCell id='path' value='&lt;b&gt;Path + redirect analyzer&lt;/b&gt;&lt;br&gt;command-specific binding; protected paths; dangerous removal review&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;BASH-AUTH-070..075&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;' vertex='1' parent='1'>
          <mxGeometry x='335' y='1050' width='265' height='75' as='geometry'/>
        </mxCell>
        <mxCell id='recognizers' value='&lt;b&gt;Narrow auto-allow recognizers&lt;/b&gt;&lt;br&gt;exact/prefix allow; sed; acceptEdits; read-only catalog&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;BASH-AUTH-080..089&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;' vertex='1' parent='1'>
