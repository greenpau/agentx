          <mxGeometry x='710' y='467' width='150' height='80' as='geometry'/>
        </mxCell>
        <mxCell id='semantic' value='&lt;b&gt;Simple: semantic argv gate&lt;/b&gt;&lt;br&gt;strip safe wrappers; reject eval/source/resolution-changing builtins&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;BASH-AUTH-017..018&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;' vertex='1' parent='1'>
          <mxGeometry x='920' y='465' width='285' height='85' as='geometry'/>
        </mxCell>
        <mxCell id='early' value='&lt;b&gt;Too-complex / semantic failure&lt;/b&gt;&lt;br&gt;exact deny/ask/allow; broad deny; per-span deny on semantic failure&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;BASH-AUTH-019&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;' vertex='1' parent='1'>
          <mxGeometry x='920' y='580' width='285' height='90' as='geometry'/>
        </mxCell>
        <mxCell id='earlyask' value='&lt;b&gt;ASK, no suggestions&lt;/b&gt;&lt;br&gt;unless an early exact or deny rule decided&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;BASH-AUTH-F004&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;' vertex='1' parent='1'>
          <mxGeometry x='1270' y='585' width='250' height='75' as='geometry'/>
        </mxCell>
        <mxCell id='legacy' value='&lt;b&gt;Parse unavailable: legacy word parse&lt;/b&gt;&lt;br&gt;malformed syntax asks; deterministic regex security battery&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;BASH-AUTH-030..034&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;' vertex='1' parent='1'>
          <mxGeometry x='360' y='595' width='280' height='90' as='geometry'/>
