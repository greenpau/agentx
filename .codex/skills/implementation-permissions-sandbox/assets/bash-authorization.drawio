        <mxCell id='ast' value='&lt;b&gt;Primary Bash AST projection&lt;/b&gt;&lt;br&gt;lexical differential prechecks; bounded allowlisted nodes&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;BASH-AUTH-010..016&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;' vertex='1' parent='1'>
