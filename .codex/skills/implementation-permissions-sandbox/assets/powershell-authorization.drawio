        <mxCell id='input' value='&lt;b&gt;Validated PowerShell request&lt;/b&gt;&lt;br&gt;command + live rules/mode + platform policy&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PS-AUTH-001..004&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;' vertex='1' parent='1'>
