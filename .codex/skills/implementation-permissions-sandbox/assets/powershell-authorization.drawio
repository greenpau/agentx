        <mxCell id='using' value='&lt;b&gt;Invisible-load checks&lt;/b&gt;&lt;br&gt;using module/assembly; #Requires; resolved providers and UNC&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PS-AUTH-050 steps 3–4&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;' vertex='1' parent='1'>
