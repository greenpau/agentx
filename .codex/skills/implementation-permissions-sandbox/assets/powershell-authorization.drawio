        </mxCell>
        <mxCell id='parser' value='&lt;b&gt;Native PowerShell parser process&lt;/b&gt;&lt;br&gt;UTF-8 data Base64 inside UTF-16LE encoded helper; byte cap; 2 attempts&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PS-AUTH-010..014&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;' vertex='1' parent='1'>
