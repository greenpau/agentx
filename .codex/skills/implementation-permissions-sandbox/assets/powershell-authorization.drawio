        <mxCell id='path' value='&lt;b&gt;AST parameter/path binding&lt;/b&gt;&lt;br&gt;closed cmdlet catalog; provider/UNC/glob/traversal; two-pass deny precedence&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PS-AUTH-070..078&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;' vertex='1' parent='1'>
          <mxGeometry x='420' y='900' width='330' height='90' as='geometry'/>
        </mxCell>
        <mxCell id='allows' value='&lt;b&gt;Candidate allows / asks&lt;/b&gt;&lt;br&gt;safe exact allow; read-only; file redirect ask; acceptEdits&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PS-AUTH-090..102&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;' vertex='1' parent='1'>
          <mxGeometry x='795' y='900' width='315' height='90' as='geometry'/>
