        <mxCell id='ask' value='&lt;b&gt;ASK&lt;/b&gt;&lt;br&gt;first ask message after all deny sources exhausted&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PS-AUTH-003,050&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;' vertex='1' parent='1'>
