          <mxGeometry x='735' y='470' width='155' height='82' as='geometry'/>
        </mxCell>
        <mxCell id='projection' value='&lt;b&gt;Project statements and commands&lt;/b&gt;&lt;br&gt;all named blocks, Param, traps, nested commands, redirects, security flags&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PS-AUTH-020..026&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;' vertex='1' parent='1'>
          <mxGeometry x='950' y='465' width='315' height='92' as='geometry'/>
        </mxCell>
        <mxCell id='rawrules' value='&lt;b&gt;Raw whole-command rules first&lt;/b&gt;&lt;br&gt;exact/prefix deny; defer ask and UNC; safe exact-allow escape only&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PS-AUTH-036..041&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;' vertex='1' parent='1'>
          <mxGeometry x='45' y='610' width='300' height='88' as='geometry'/>
        </mxCell>
        <mxCell id='fallback' value='&lt;b&gt;Invalid parse fallback&lt;/b&gt;&lt;br&gt;strip continuations/backticks; split fragments; normalize assignments/invocation; scan deny&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PS-AUTH-042&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;' vertex='1' parent='1'>
          <mxGeometry x='400' y='605' width='325' height='98' as='geometry'/>
        </mxCell>
        <mxCell id='fallbackresult' value='&lt;b&gt;DENY or ASK, no suggestion&lt;/b&gt;&lt;br&gt;dangerous Remove-Item is hard deny; otherwise preserve deferred ask/error&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PS-AUTH-043,111; PS-AUTH-F001&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;' vertex='1' parent='1'>
          <mxGeometry x='785' y='610' width='315' height='88' as='geometry'/>
        </mxCell>
        <mxCell id='collecttitle' value='&lt;b&gt;Successful parse: collect every decision before reducing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PS-AUTH-003,050&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;' vertex='1' parent='1'>
