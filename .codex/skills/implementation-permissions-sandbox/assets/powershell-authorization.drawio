        </mxCell>
        <mxCell id='identity' value='&lt;b&gt;Identity + rule normalization&lt;/b&gt;&lt;br&gt;raw nameType; module/alias forms; Unicode parameters; every direct/nested command&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PS-AUTH-030..039,051&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;' vertex='1' parent='1'>
