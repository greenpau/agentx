        <mxCell id='title' value='PowerShell authorization: native AST, degraded deny preservation, and platform isolation' style='text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;' vertex='1' parent='1'>
