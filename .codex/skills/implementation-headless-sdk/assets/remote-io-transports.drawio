        </mxCell>
        <mxCell id='hybrid' value='&lt;b&gt;Hybrid HTTP writer&lt;/b&gt;&lt;br&gt;100 ms stream buffer&lt;br&gt;serial batches + retry/backpressure&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;HTR-020..023&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;' vertex='1' parent='1'>
