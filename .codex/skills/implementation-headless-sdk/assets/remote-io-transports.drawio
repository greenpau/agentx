        </mxCell>
        <mxCell id='sse' value='&lt;b&gt;SSE observer&lt;/b&gt;&lt;br&gt;sequence advances before validation&lt;br&gt;liveness + bounded reconnect&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;HTR-030..033&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;' vertex='1' parent='1'>
