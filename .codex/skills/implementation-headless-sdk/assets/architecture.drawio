      <mxCell id="ctx-owns" value="&lt;b&gt;Owns&lt;/b&gt;&lt;br&gt;Headless dual loop and correlated protocol&lt;br&gt;&lt;br&gt;Owns headless dual loop and correlated protocol: accepts NDJSON / text input, governs the responsibilities and branches shown on the flow page, and produces EOF after workload → unbounded team gate → adapter close / cleanup." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=2;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="430" y="605" width="380" height="150" as="geometry"/></mxCell>
