        <mxCell id='title' value='Persistent memory has three independent lifecycles: recall, shared sync, and consolidation' style='text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;' vertex='1' parent='1'>
          <mxGeometry x='50' y='390' width='1600' height='45' as='geometry'/>
        </mxCell>
        <mxCell id='privateLane' value='PRIVATE / PROJECT FILE MEMORY' style='swimlane;html=1;horizontal=1;startSize=35;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;' vertex='1' parent='1'>
          <mxGeometry x='50' y='455' width='535' height='880' as='geometry'/>
        </mxCell>
        <mxCell id='path' value='&lt;b&gt;Validated memory root&lt;/b&gt;&lt;br&gt;trusted override or canonical repository identity&lt;br&gt;reject roots · traversal · untrusted project override&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MC-MEM-001/002&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;' vertex='1' parent='privateLane'>
          <mxGeometry x='55' y='70' width='420' height='95' as='geometry'/>
        </mxCell>
        <mxCell id='topics' value='&lt;b&gt;Topic files&lt;/b&gt;&lt;br&gt;user · feedback · project · reference&lt;br&gt;frontmatter + detailed memory' style='shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;' vertex='1' parent='privateLane'>
          <mxGeometry x='55' y='225' width='200' height='100' as='geometry'/>
        </mxCell>
        <mxCell id='index' value='&lt;b&gt;MEMORY.md index&lt;/b&gt;&lt;br&gt;200 lines / 25,000 UTF-16 units&lt;br&gt;prompt-loaded when present' style='shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;' vertex='1' parent='privateLane'>
          <mxGeometry x='275' y='225' width='200' height='100' as='geometry'/>
        </mxCell>
        <mxCell id='scan' value='&lt;b&gt;Header scan + selector&lt;/b&gt;&lt;br&gt;30 lines · 200 newest · ≤5 names&lt;br&gt;exclude surfaced paths and working-tool docs' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;' vertex='1' parent='privateLane'>
          <mxGeometry x='55' y='390' width='420' height='95' as='geometry'/>
        </mxCell>
        <mxCell id='prefetch' value='&lt;b&gt;Nonblocking relevance prefetch&lt;/b&gt;&lt;br&gt;one per multiword turn · consume only if settled&lt;br&gt;abort on query exit' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;' vertex='1' parent='privateLane'>
          <mxGeometry x='55' y='535' width='420' height='90' as='geometry'/>
        </mxCell>
        <mxCell id='context' value='&lt;b&gt;Bounded model context&lt;/b&gt;&lt;br&gt;4,096 bytes / 200 lines each · 60 KiB projected total&lt;br&gt;old memories carry verify-current-state warning' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;' vertex='1' parent='privateLane'>
          <mxGeometry x='55' y='680' width='420' height='95' as='geometry'/>
        </mxCell>
        <mxCell id='teamLane' value='SHARED TEAM MEMORY SYNC' style='swimlane;html=1;horizontal=1;startSize=35;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;' vertex='1' parent='1'>
          <mxGeometry x='625' y='455' width='650' height='880' as='geometry'/>
        </mxCell>
        <mxCell id='teamDir' value='&lt;b&gt;Local team/ directory&lt;/b&gt;&lt;br&gt;shared MEMORY.md is wrapped as untrusted content&lt;br&gt;all regular files eligible for sync' style='shape=folder;tabWidth=90;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;' vertex='1' parent='teamLane'>
          <mxGeometry x='45' y='70' width='250' height='105' as='geometry'/>
        </mxCell>
        <mxCell id='guard' value='&lt;b&gt;Path + secret + size guards&lt;/b&gt;&lt;br&gt;lexical and real-path containment&lt;br&gt;skip secrets/unreadable/&gt;250,000-byte files' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;' vertex='1' parent='teamLane'>
          <mxGeometry x='345' y='70' width='260' height='105' as='geometry'/>
        </mxCell>
        <mxCell id='delta' value='&lt;b&gt;One local snapshot → hashes → delta&lt;/b&gt;&lt;br&gt;no deletion propagation&lt;br&gt;sorted batches under 200,000-byte soft limit' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;' vertex='1' parent='teamLane'>
          <mxGeometry x='45' y='245' width='560' height='95' as='geometry'/>
        </mxCell>
        <mxCell id='batch' value='&lt;b&gt;Independent PUT commits&lt;/b&gt;&lt;br&gt;update ETag + believed hashes after each batch&lt;br&gt;later failure leaves earlier batches committed' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;' vertex='1' parent='teamLane'>
          <mxGeometry x='45' y='410' width='265' height='110' as='geometry'/>
        </mxCell>
        <mxCell id='server' value='&lt;b&gt;Repository-scoped server&lt;/b&gt;&lt;br&gt;upsert entries · ETag · per-key hashes&lt;br&gt;structured entry limit may be learned' style='shape=cloud;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;' vertex='1' parent='teamLane'>
          <mxGeometry x='355' y='410' width='250' height='110' as='geometry'/>
        </mxCell>
        <mxCell id='conflict' value='&lt;b&gt;412 hashes-only probe&lt;/b&gt;&lt;br&gt;recompute delta against unchanged local snapshot&lt;br&gt;local same-key edit wins retry; no body merge' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;' vertex='1' parent='teamLane'>
          <mxGeometry x='45' y='590' width='560' height='95' as='geometry'/>
        </mxCell>
        <mxCell id='startup' value='&lt;b&gt;Startup: pull before watcher/push&lt;/b&gt;&lt;br&gt;server wins per key · omissions do not delete local&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;crash can leave unsynced edit that next pull overwrites&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;' vertex='1' parent='teamLane'>
          <mxGeometry x='45' y='750' width='560' height='90' as='geometry'/>
        </mxCell>
        <mxCell id='dreamLane' value='AUTO-DREAM CONSOLIDATION' style='swimlane;html=1;horizontal=1;startSize=35;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;' vertex='1' parent='1'>
          <mxGeometry x='1315' y='455' width='435' height='880' as='geometry'/>
        </mxCell>
        <mxCell id='gates' value='&lt;b&gt;Stop-phase scheduling gates&lt;/b&gt;&lt;br&gt;main · non-bare · nonremote · non-KAIROS&lt;br&gt;24 h · 5 prior sessions · 10 min scan throttle' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;' vertex='1' parent='dreamLane'>
          <mxGeometry x='45' y='70' width='345' height='105' as='geometry'/>
        </mxCell>
        <mxCell id='lock' value='&lt;b&gt;.consolidate-lock&lt;/b&gt;&lt;br&gt;mtime = schedule timestamp · body = process ID&lt;br&gt;write then verify last writer; 1 h stale guard&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;not an atomic filesystem lock&lt;/font&gt;' style='shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;' vertex='1' parent='dreamLane'>
          <mxGeometry x='45' y='245' width='345' height='115' as='geometry'/>
        </mxCell>
        <mxCell id='fork' value='&lt;b&gt;Consolidation fork&lt;/b&gt;&lt;br&gt;skip transcript · cache-sharing&lt;br&gt;memory-root file writes + read-only shell only' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;' vertex='1' parent='dreamLane'>
          <mxGeometry x='45' y='430' width='345' height='100' as='geometry'/>
        </mxCell>
        <mxCell id='dreamFiles' value='&lt;b&gt;Topic/index file edits&lt;/b&gt;&lt;br&gt;UI task paths are observed lower bound&lt;br&gt;file writes are not rolled back' style='shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;' vertex='1' parent='dreamLane'>
