        </mxCell>
        <mxCell id='queue' value='&lt;b&gt;Process-local completion queue&lt;/b&gt;&lt;br&gt;winner attempts enqueue after latch flip&lt;br&gt;diagnostic queue records are not replayed&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TR-037&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;' vertex='1' parent='1'>
          <mxGeometry x='920' y='525' width='300' height='115' as='geometry'/>
        </mxCell>
        <mxCell id='model' value='&lt;b&gt;Model-visible task notification&lt;/b&gt;&lt;br&gt;later converted to user-role internal context&lt;br&gt;may eventually enter transcript&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;not a human request&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;' vertex='1' parent='1'>
