        <mxCell id='crash1' value='&lt;b&gt;CRASH WINDOW A&lt;/b&gt;&lt;br&gt;after latch flip, before enqueue&lt;br&gt;→ missing completion' style='shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;' vertex='1' parent='1'>
