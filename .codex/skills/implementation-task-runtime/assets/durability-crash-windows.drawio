        <mxCell id='sidecar' value='&lt;b&gt;Best-effort remote sidecar&lt;/b&gt;&lt;br&gt;task ID · remote session · spawn metadata&lt;br&gt;independent write/remove; parse failures skipped&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TR-060 · TR-061&lt;/font&gt;' style='shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;' vertex='1' parent='1'>
