        <mxCell id='remote' value='&lt;b&gt;Remote service truth&lt;/b&gt;&lt;br&gt;live → implement running&lt;br&gt;archived / 404 → remove sidecar, no synthetic completion&lt;br&gt;auth/network → preserve hint' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;' vertex='1' parent='1'>
