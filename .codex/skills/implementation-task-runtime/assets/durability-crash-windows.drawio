        </mxCell>
        <mxCell id='crash2' value='&lt;b&gt;CRASH WINDOW B&lt;/b&gt;&lt;br&gt;after enqueue, before consumption&lt;br&gt;→ in-memory item lost' style='shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;' vertex='1' parent='1'>
