        </mxCell>
        <mxCell id='writer' value='&lt;b&gt;Credential-safe output writer&lt;/b&gt;&lt;br&gt;ordered cross-chunk filtering before persistence&lt;br&gt;bounded drain · no journal/fsync guarantee&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TR-023 · TR-039 · TR-094&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;' vertex='1' parent='1'>
