        <mxCell id='result' value='&lt;b&gt;Normalized outcome&lt;/b&gt;&lt;br&gt;success · no_permissions&lt;br&gt;install_failed · in_progress&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UPD-001..002&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;' vertex='1' parent='1'>
