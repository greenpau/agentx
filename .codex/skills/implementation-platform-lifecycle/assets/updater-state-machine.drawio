          <mxGeometry x='50' y='390' width='1000' height='45' as='geometry'/>
        </mxCell>
        <mxCell id='discover' value='&lt;b&gt;Discover target&lt;/b&gt;&lt;br&gt;channel → registry tag or object-store pointer&lt;br&gt;5 s bound · home cwd&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UPD-050..054&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;' vertex='1' parent='1'>
          <mxGeometry x='50' y='535' width='255' height='105' as='geometry'/>
        </mxCell>
        <mxCell id='policy' value='&lt;b&gt;Apply version policy&lt;/b&gt;&lt;br&gt;server maximum · user floor&lt;br&gt;semantic comparison · never auto-downgrade&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UPD-005, UPD-013, UPD-021&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;' vertex='1' parent='1'>
          <mxGeometry x='365' y='535' width='255' height='105' as='geometry'/>
        </mxCell>
        <mxCell id='route' value='&lt;b&gt;Diagnose installation&lt;/b&gt;&lt;br&gt;package-manager → guidance&lt;br&gt;native · local · global → owned mechanism&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UPD-080..084&lt;/font&gt;' style='rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;' vertex='1' parent='1'>
          <mxGeometry x='690' y='525' width='265' height='125' as='geometry'/>
        </mxCell>
        <mxCell id='lock1' value='&lt;b&gt;Observe lock&lt;/b&gt;&lt;br&gt;fresh → in_progress&lt;br&gt;absent → exclusive create&lt;br&gt;stale → second stat&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UPD-030..033&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;' vertex='1' parent='1'>
          <mxGeometry x='1025' y='535' width='255' height='105' as='geometry'/>
        </mxCell>
        <mxCell id='owned' value='&lt;b&gt;Lock owned&lt;/b&gt;&lt;br&gt;payload = exact process identifier&lt;br&gt;crash recovery after 5 min&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UPD-035..037&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;' vertex='1' parent='1'>
          <mxGeometry x='1025' y='715' width='255' height='95' as='geometry'/>
        </mxCell>
        <mxCell id='aliases' value='&lt;b&gt;Best-effort alias cleanup&lt;/b&gt;&lt;br&gt;known shell files in order&lt;br&gt;per-file failure continues&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UPD-070&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;' vertex='1' parent='1'>
          <mxGeometry x='690' y='715' width='255' height='95' as='geometry'/>
        </mxCell>
        <mxCell id='guard' value='&lt;b&gt;Compatibility + authorization&lt;/b&gt;&lt;br&gt;reject Windows npm in WSL&lt;br&gt;discover prefix · prove write access&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UPD-040..043, UPD-071..072&lt;/font&gt;' style='rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;' vertex='1' parent='1'>
          <mxGeometry x='365' y='700' width='255' height='125' as='geometry'/>
        </mxCell>
        <mxCell id='install' value='&lt;b&gt;Explicit global install&lt;/b&gt;&lt;br&gt;npm|bun install -g one package argument&lt;br&gt;home cwd · no updater-local timeout&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UPD-073..074&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;' vertex='1' parent='1'>
          <mxGeometry x='50' y='710' width='255' height='105' as='geometry'/>
        </mxCell>
        <mxCell id='metadata' value='&lt;b&gt;Record mechanism&lt;/b&gt;&lt;br&gt;preserve config · installMethod = global&lt;br&gt;only after zero exit&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UPD-075&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;' vertex='1' parent='1'>
          <mxGeometry x='50' y='905' width='255' height='95' as='geometry'/>
        </mxCell>
        <mxCell id='release' value='&lt;b&gt;Finally: owner-aware release&lt;/b&gt;&lt;br&gt;unlink only exact identifier&lt;br&gt;absence succeeds · foreign lock preserved&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UPD-034..035&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;' vertex='1' parent='1'>
