        <mxCell id='strict' value='&lt;b&gt;Strict safe parse&lt;/b&gt;&lt;br&gt;null/invalid collapse publicly&lt;br&gt;50-entry small-input cache&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PRIM-011..014&lt;/font&gt;' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;' vertex='1' parent='1'>
