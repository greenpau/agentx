{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AgentX: Test Go",
      "type": "process",
      "command": "go",
      "args": [
        "test",
        "./..."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$go"
    }
  ]
}
